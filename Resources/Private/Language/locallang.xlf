<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2026-07-31T00:00:00Z">
        <body>
            <trans-unit id="assistant.title"><source>Browser AI assistant</source></trans-unit>
            <trans-unit id="assistant.region"><source>Browser AI assistant</source></trans-unit>
            <trans-unit id="field.question"><source>Your question</source></trans-unit>
            <trans-unit id="action.setup"><source>Set up browser AI</source></trans-unit>
            <trans-unit id="action.ask"><source>Ask</source></trans-unit>
            <trans-unit id="action.abort"><source>Stop response</source></trans-unit>
            <trans-unit id="action.reset"><source>Reset conversation</source></trans-unit>
            <trans-unit id="action.retry"><source>Retry</source></trans-unit>
            <trans-unit id="progress.download"><source>Browser AI model download</source></trans-unit>
            <trans-unit id="status.checking"><source>Checking browser AI availability…</source></trans-unit>
            <trans-unit id="status.downloadable"><source>Browser AI needs to be set up before use.</source></trans-unit>
            <trans-unit id="status.downloading"><source>Setting up browser AI…</source></trans-unit>
            <trans-unit id="status.ready"><source>Browser AI is ready.</source></trans-unit>
            <trans-unit id="status.streaming"><source>Generating an answer…</source></trans-unit>
            <trans-unit id="status.resetRequired"><source>The model context is full. Reset the conversation to continue.</source></trans-unit>
            <trans-unit id="status.errorRetryable"><source>Browser AI could not be reached. You can retry.</source></trans-unit>
            <trans-unit id="status.unavailable"><source>Browser AI is unavailable in this browser.</source></trans-unit>
            <trans-unit id="link.newTab"><source>Opens in a new tab.</source></trans-unit>
            <trans-unit id="configuration.summary"><source>How this assistant is configured</source></trans-unit>
            <trans-unit id="configuration.lead"><source>These are the instructions and limits this assistant works under. Everything below runs in your browser; nothing is sent to a server.</source></trans-unit>
            <trans-unit id="configuration.systemPrompt"><source>System prompt</source></trans-unit>
            <trans-unit id="configuration.supplementalInstruction"><source>Editor instruction</source></trans-unit>
            <trans-unit id="configuration.contextSelector"><source>Page area used as the source</source></trans-unit>
            <trans-unit id="configuration.contextUsageLimit"><source>Share of the model input the page text may occupy</source></trans-unit>
            <trans-unit id="configuration.note"><source>The model additionally receives an instruction to answer in the language of the question, and the text of the selected page area. Nothing else is passed to it.</source></trans-unit>
            <trans-unit id="formAssistant.title"><source>Fill this form by describing what you want</source></trans-unit>
            <trans-unit id="formAssistant.region"><source>Form assistant</source></trans-unit>
            <trans-unit id="field.request"><source>What do you want to know?</source></trans-unit>
            <trans-unit id="action.derive"><source>Fill and run</source></trans-unit>
            <trans-unit id="formStatus.ready"><source>Describe what you want and the form will be filled with it.</source></trans-unit>
            <trans-unit id="formStatus.deriving"><source>Deriving the parameters…</source></trans-unit>
            <trans-unit id="formStatus.querying"><source>Running the query…</source></trans-unit>
            <trans-unit id="formStatus.phrasing"><source>Putting the result into words…</source></trans-unit>
            <trans-unit id="formDisclosure.summary"><source>Show the form these values were put into</source></trans-unit>
            <trans-unit id="formStatus.filled"><source>Answered. Open the form below to see or correct the values it used.</source></trans-unit>
            <trans-unit id="formStatus.rejected"><source>The derived parameters did not fit the form, so nothing was changed. Try describing it differently.</source></trans-unit>
            <trans-unit id="formStatus.unresolvedPlace"><source>That place could not be found. Try a larger nearby place or add the country.</source></trans-unit>
            <trans-unit id="formStatus.queryFailed"><source>The data source could not be reached. The form keeps its values, so you can run it again.</source></trans-unit>
            <trans-unit id="formStatus.rateLimited"><source>The data source is refusing further requests for now. Wait a moment and run it again.</source></trans-unit>
            <trans-unit id="formStatus.unavailable"><source>Browser AI is unavailable in this browser. The form can still be filled in and run by hand.</source></trans-unit>
            <trans-unit id="formResult.caption"><source>Query result</source></trans-unit>
            <trans-unit id="formResult.place"><source>Place</source></trans-unit>
            <trans-unit id="formResult.time"><source>Time</source></trans-unit>
            <trans-unit id="formConfiguration.summary"><source>What this form exposes to an assistant</source></trans-unit>
            <trans-unit id="formConfiguration.lead"><source>The form is offered as a tool: a name, a description and a schema derived from the form's own definition. Everything below runs in your browser; only the query itself leaves it, to the data source.</source></trans-unit>
            <trans-unit id="formConfiguration.toolName"><source>Tool name</source></trans-unit>
            <trans-unit id="formConfiguration.toolDescription"><source>Tool description</source></trans-unit>
            <trans-unit id="formConfiguration.systemPrompt"><source>System prompt</source></trans-unit>
            <trans-unit id="formConfiguration.schema"><source>Input schema</source></trans-unit>
            <trans-unit id="formConfiguration.lastCall"><source>Last tool call</source></trans-unit>
            <trans-unit id="formConfiguration.noCallYet"><source>No call yet.</source></trans-unit>
            <trans-unit id="formConfiguration.note"><source>The same tool is registered with the browser's model context where that is available, so an agent outside this page can call it with the identical schema.</source></trans-unit>
        </body>
    </file>

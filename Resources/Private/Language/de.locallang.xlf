            <trans-unit id="field.question"><source>Your question</source><target>Ihre Frage</target></trans-unit>
            <trans-unit id="action.setup"><source>Set up browser AI</source><target>Browser-KI einrichten</target></trans-unit>
            <trans-unit id="action.ask"><source>Ask</source><target>Fragen</target></trans-unit>
            <trans-unit id="action.abort"><source>Stop response</source><target>Antwort stoppen</target></trans-unit>
            <trans-unit id="action.reset"><source>Reset conversation</source><target>Unterhaltung zurücksetzen</target></trans-unit>

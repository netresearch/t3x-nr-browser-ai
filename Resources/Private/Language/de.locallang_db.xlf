    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-07-31T00:00:00Z">
        <body>
            <trans-unit id="plugin.assistant.title" resname="plugin.assistant.title"><source>Browser AI assistant</source><target>Browser-KI-Assistent</target></trans-unit>
            <trans-unit id="plugin.assistant.description" resname="plugin.assistant.description"><source>On-device assistant using the current page as its source</source><target>Assistent auf dem Endgerät, der die aktuelle Seite als Quelle nutzt</target></trans-unit>
            <trans-unit id="flexform.sheet.assistant" resname="flexform.sheet.assistant"><source>Assistant</source><target>Assistent</target></trans-unit>
            <trans-unit id="flexform.field.title" resname="flexform.field.title"><source>Title</source><target>Titel</target></trans-unit>
            <trans-unit id="flexform.field.introduction" resname="flexform.field.introduction"><source>Introduction</source><target>Einleitung</target></trans-unit>
            <trans-unit id="flexform.field.supplementalInstruction" resname="flexform.field.supplementalInstruction"><source>Supplemental instruction</source><target>Ergänzende Anweisung</target></trans-unit>
            <trans-unit id="flexform.field.contextSelector" resname="flexform.field.contextSelector"><source>Context selector</source><target>Kontextselektor</target></trans-unit>
            <trans-unit id="flexform.field.fallbackMode" resname="flexform.field.fallbackMode"><source>Fallback mode</source><target>Fallback-Modus</target></trans-unit>
            <trans-unit id="flexform.field.fallbackContent" resname="flexform.field.fallbackContent"><source>Fallback content element</source><target>Fallback-Inhaltselement</target></trans-unit>
            <trans-unit id="flexform.item.fallbackMode.none" resname="flexform.item.fallbackMode.none"><source>None</source><target>Kein Fallback</target></trans-unit>
            <trans-unit id="flexform.item.fallbackMode.contentElement" resname="flexform.item.fallbackMode.contentElement"><source>Content element</source><target>Inhaltselement</target></trans-unit>
            <trans-unit id="flexform.field.showConfiguration" resname="flexform.field.showConfiguration"><source>Show configuration</source><target>Konfiguration anzeigen</target></trans-unit>
            <trans-unit id="flexform.field.showConfiguration.description" resname="flexform.field.showConfiguration.description"><source>Renders a collapsed block naming the system prompt, the editor instruction, the page area used as the source and the context limit. Visible whether or not the browser can run the model.</source><target>Gibt einen zugeklappten Block aus, der System-Prompt, Redaktionsanweisung, den als Quelle genutzten Seitenbereich und die Kontextgrenze benennt. Wird auch dann angezeigt, wenn der Browser das Modell nicht ausführen kann.</target></trans-unit>
            <trans-unit id="flexform.field.notFoundMode" resname="flexform.field.notFoundMode"><source>When the page does not answer</source><target>Wenn die Seite die Antwort nicht hergibt</target></trans-unit>
            <trans-unit id="flexform.field.notFoundMode.description" resname="flexform.field.notFoundMode.description"><source>Choose 'Content element' to show a prepared element instead of the model's refusal. The model is then instructed to signal an unanswerable question, and the interface replaces its reply with that element.</source><target>Mit „Inhaltselement“ erscheint ein vorbereitetes Element anstelle der Absage des Modells. Das Modell wird dann angewiesen, eine unbeantwortbare Frage zu kennzeichnen, und die Oberfläche ersetzt seine Antwort durch dieses Element.</target></trans-unit>
            <trans-unit id="flexform.field.notFoundContent" resname="flexform.field.notFoundContent"><source>Content element for an unanswerable question</source><target>Inhaltselement für eine unbeantwortbare Frage</target></trans-unit>
            <trans-unit id="flexform.item.notFoundMode.none" resname="flexform.item.notFoundMode.none"><source>Show the model's own wording</source><target>Formulierung des Modells zeigen</target></trans-unit>
            <trans-unit id="flexform.item.notFoundMode.contentElement" resname="flexform.item.notFoundMode.contentElement"><source>Content element</source><target>Inhaltselement</target></trans-unit>
        </body>
    </file>

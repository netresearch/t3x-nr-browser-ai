<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2026-07-30T00:00:00Z">
        <body>
            <trans-unit id="plugin.assistant.title" resname="plugin.assistant.title">
                <source>Browser AI assistant</source>
            </trans-unit>
            <trans-unit id="plugin.assistant.description" resname="plugin.assistant.description">
                <source>On-device assistant using the current page as its source</source>
            </trans-unit>
            <trans-unit id="flexform.sheet.assistant" resname="flexform.sheet.assistant">
                <source>Assistant</source>
            </trans-unit>
            <trans-unit id="flexform.field.title" resname="flexform.field.title">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="flexform.field.headingLevel" resname="flexform.field.headingLevel">
                <source>Heading level</source>
            </trans-unit>
            <trans-unit id="flexform.field.headingLevel.description" resname="flexform.field.headingLevel.description">
                <source>The level the plugin's own title renders at. Pick the one that fits where the plugin sits: a section already introduced by an h2 wants h3 here, so the document outline stays a hierarchy instead of two headings on the same level.</source>
            </trans-unit>
            <trans-unit id="flexform.item.headingLevel.h2" resname="flexform.item.headingLevel.h2">
                <source>Heading 2 — the plugin introduces its own section</source>
            </trans-unit>
            <trans-unit id="flexform.item.headingLevel.h3" resname="flexform.item.headingLevel.h3">
                <source>Heading 3 — the plugin sits inside a section</source>
            </trans-unit>
            <trans-unit id="flexform.item.headingLevel.h4" resname="flexform.item.headingLevel.h4">
                <source>Heading 4 — the plugin sits inside a subsection</source>
            </trans-unit>
            <trans-unit id="flexform.field.introduction" resname="flexform.field.introduction">
                <source>Introduction</source>
            </trans-unit>
            <trans-unit id="flexform.field.supplementalInstruction" resname="flexform.field.supplementalInstruction">
                <source>Supplemental instruction</source>
            </trans-unit>
            <trans-unit id="flexform.field.contextSelector" resname="flexform.field.contextSelector">
                <source>Context selector</source>
            </trans-unit>
            <trans-unit id="flexform.field.fallbackMode" resname="flexform.field.fallbackMode">
                <source>Fallback mode</source>
            </trans-unit>
            <trans-unit id="flexform.field.fallbackContent" resname="flexform.field.fallbackContent">
                <source>Fallback content element</source>
            </trans-unit>
            <trans-unit id="flexform.item.fallbackMode.none" resname="flexform.item.fallbackMode.none">
                <source>None</source>
            </trans-unit>
            <trans-unit id="flexform.item.fallbackMode.contentElement" resname="flexform.item.fallbackMode.contentElement">
                <source>Content element</source>
            </trans-unit>
            <trans-unit id="flexform.field.showConfiguration" resname="flexform.field.showConfiguration">
                <source>Show configuration</source>
            </trans-unit>
            <trans-unit id="flexform.field.showConfiguration.description" resname="flexform.field.showConfiguration.description">
                <source>Renders a collapsed block naming the system prompt, the editor instruction, the page area used as the source and the context limit. Visible whether or not the browser can run the model.</source>
            </trans-unit>
            <trans-unit id="flexform.field.notFoundMode" resname="flexform.field.notFoundMode">
                <source>When the page does not answer</source>
            </trans-unit>
            <trans-unit id="flexform.field.notFoundMode.description" resname="flexform.field.notFoundMode.description">
                <source>Choose 'Content element' to show a prepared element instead of the model's refusal. The model is then instructed to signal an unanswerable question, and the interface replaces its reply with that element.</source>
            </trans-unit>
            <trans-unit id="flexform.field.notFoundContent" resname="flexform.field.notFoundContent">
                <source>Content element for an unanswerable question</source>
            </trans-unit>
            <trans-unit id="flexform.item.notFoundMode.none" resname="flexform.item.notFoundMode.none">
                <source>Show the model's own wording</source>
            </trans-unit>
            <trans-unit id="flexform.item.notFoundMode.contentElement" resname="flexform.item.notFoundMode.contentElement">
                <source>Content element</source>
            </trans-unit>
            <trans-unit id="plugin.formAssistant.title" resname="plugin.formAssistant.title">
                <source>Browser AI form assistant</source>
            </trans-unit>
            <trans-unit id="plugin.formAssistant.description" resname="plugin.formAssistant.description">
                <source>On-device assistant that fills a parameter-rich form from one sentence and runs it</source>
            </trans-unit>
            <trans-unit id="flexform.sheet.formAssistant" resname="flexform.sheet.formAssistant">
                <source>Form assistant</source>
            </trans-unit>
            <trans-unit id="flexform.field.formIdentifier" resname="flexform.field.formIdentifier">
                <source>Form</source>
            </trans-unit>
            <trans-unit id="flexform.field.formIdentifier.description" resname="flexform.field.formIdentifier.description">
                <source>The form this plugin renders and offers as a tool. Its definition is also what the input schema is derived from, so the controls and the schema always describe the same form.</source>
            </trans-unit>
            <trans-unit id="flexform.item.formIdentifier.weatherQuery" resname="flexform.item.formIdentifier.weatherQuery">
                <source>Weather query</source>
            </trans-unit>
            <trans-unit id="flexform.field.showConfiguration.formAssistant.description" resname="flexform.field.showConfiguration.formAssistant.description">
                <source>Renders a collapsed block naming the tool, its description, the system prompt, the input schema and the arguments of the last call. Visible whether or not the browser can run the model.</source>
            </trans-unit>
            <trans-unit id="flexform.field.persistenceIdentifier" resname="flexform.field.persistenceIdentifier">
                <source>Form from the form editor</source>
            </trans-unit>
            <trans-unit id="flexform.field.persistenceIdentifier.description" resname="flexform.field.persistenceIdentifier.description">
                <source>A form created in the TYPO3 form editor. When one is chosen it replaces the bundled form below. The input schema is derived from its definition, so the controls and the schema describe the same form; field descriptions come from each element's description in the form editor.</source>
            </trans-unit>
            <trans-unit id="flexform.item.persistenceIdentifier.bundled" resname="flexform.item.persistenceIdentifier.bundled">
                <source>Use the bundled form</source>
            </trans-unit>
            <trans-unit id="flexform.field.dataSource" resname="flexform.field.dataSource">
                <source>Data source</source>
            </trans-unit>
            <trans-unit id="flexform.field.dataSource.description" resname="flexform.field.dataSource.description">
                <source>What running the form does. Leave empty to use the data source the form definition names under renderingOptions.nrBrowserAi.action; a form without one stays a plain form and offers no tool.</source>
            </trans-unit>
            <trans-unit id="flexform.item.dataSource.fromForm" resname="flexform.item.dataSource.fromForm">
                <source>From the form definition</source>
            </trans-unit>
            <trans-unit id="flexform.item.dataSource.openMeteo" resname="flexform.item.dataSource.openMeteo">
                <source>Open-Meteo weather forecast</source>
            </trans-unit>
            <trans-unit id="flexform.field.toolDescription" resname="flexform.field.toolDescription">
                <source>Tool description</source>
            </trans-unit>
            <trans-unit id="flexform.field.toolDescription.description" resname="flexform.field.toolDescription.description">
                <source>What the form does, in a sentence or two, for the model and for agents that call the tool. Leave empty to use the description in the form definition, or one derived from the form label.</source>
            </trans-unit>
            <trans-unit id="flexform.item.dataSource.jsonEndpoint" resname="flexform.item.dataSource.jsonEndpoint">
                <source>JSON endpoint (HTTPS GET)</source>
            </trans-unit>
            <trans-unit id="flexform.field.dataSourceEndpoint" resname="flexform.field.dataSourceEndpoint">
                <source>Endpoint URL</source>
            </trans-unit>
            <trans-unit id="flexform.field.dataSourceEndpoint.description" resname="flexform.field.dataSourceEndpoint.description">
                <source>HTTPS URL without query string or credentials. The form's parameters are appended as query parameters named after the form elements, and the visitor's browser requests the URL directly. The host must be listed under allowedDataSourceHosts in the site settings, otherwise the form stays a plain form.</source>
            </trans-unit>
        </body>
    </file>
</xliff>

#!/usr/bin/env bash

## Description: Install TYPO3 14.3 with the local nr-browser-ai extension
## Usage: install-v14
## Example: ddev install-v14

set -euo pipefail

# Bootstrap contract: typo3/minimal:"$TYPO3_VERSION",
# typo3/cms-install:"$TYPO3_VERSION", TYPO3_SETUP_ADMIN_USERNAME,
# TYPO3_SETUP_ADMIN_PASSWORD, data-nr-browser-ai-root.
exec /mnt/ddev_config/commands/web/_install-typo3 v14

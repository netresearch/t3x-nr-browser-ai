#!/usr/bin/env bash

## Description: Install TYPO3 14.3 with the local nr-browser-ai extension
## Usage: install-v14
## Example: ddev install-v14

set -euo pipefail

VERSION=v14
TYPO3_VERSION='^14.3'
INSTALL_DIR="/var/www/html/$VERSION"
EXTENSION_PATH="/var/www/nr_browser_ai"
PACKAGE_NAME="netresearch/nr-browser-ai"
SITE_URL="https://${VERSION}.nr-browser-ai.ddev.site"

# Bootstrap contract: typo3/minimal:"$TYPO3_VERSION",
# typo3/cms-install:"$TYPO3_VERSION", TYPO3_SETUP_ADMIN_USERNAME,
# TYPO3_SETUP_ADMIN_PASSWORD, data-nr-browser-ai-root.
exec /mnt/ddev_config/commands/web/_install-typo3 \
    "$VERSION" "$TYPO3_VERSION" "$INSTALL_DIR" "$EXTENSION_PATH" "$PACKAGE_NAME" "$SITE_URL"
